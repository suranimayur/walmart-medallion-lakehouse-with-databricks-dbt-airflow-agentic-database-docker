# ==============================================================================
# Environment configuration template — Walmart Databricks dbt + Airflow project
# ==============================================================================
# USAGE
#   1. Copy this file:            cp .env.example .env   (run inside walmart-airflow/)
#   2. Fill in the real values (see each section below for where to find them).
#   3. .env is loaded automatically by docker compose into every Airflow
#      container, and is read by profiles.yml for local dbt development.
#   4. .env is git-ignored. NEVER commit the real file.
#
# SECURITY
#   - Treat every value below as a credential. Rotate any token that has ever
#     been committed to git history.
#   - Prefer short-lived tokens scoped to a service principal in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Databricks workspace + SQL warehouse (used by dbt adapter & the DAG)
# ------------------------------------------------------------------------------
# Host:  Databricks UI -> Compute -> your SQL warehouse -> Connection details
#        (do NOT include https:// here; profiles.yml adds the scheme)
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com

# Personal Access Token: Databricks UI -> Settings -> Developer -> Access tokens
#   - Set a lifetime (e.g. 90 days) and rotate it.
#   - In production prefer an OAuth M2M token from a service principal.
DATABRICKS_TOKEN=

# HTTP path of the SQL warehouse dbt will run against (Connection details pane)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/aaaaaaaaaaaaaaaa

# ------------------------------------------------------------------------------
# 2. CDC ingest job (triggered by the ingest_cdc Airflow task)
# ------------------------------------------------------------------------------
# Job ID: Databricks UI -> Jobs & pipelines -> your ingest pipeline -> Job ID
# The DAG aborts fast (no hang) if this is missing.
DATABRICKS_CDC_JOB_ID=

# ------------------------------------------------------------------------------
# 3. Airflow docker-compose platform settings
# ------------------------------------------------------------------------------
# Linux UID used for bind-mount permissions (Windows/macOS: leave 50000)
AIRFLOW_UID=50000

# Fernet key used to encrypt Airflow connections/variables at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT secret for the Airflow 3 execution API — change from the default.
AIRFLOW__API_AUTH__JWT_SECRET=change-me

# Initial admin account created by airflow-init on first start
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Image tag for the custom Airflow image built from ./Dockerfile
AIRFLOW_IMAGE_NAME=walmart-airflow:latest

# ------------------------------------------------------------------------------
# 4. Source freshness SLA (dbt source freshness, in days)
# ------------------------------------------------------------------------------
# Defaults fit the static demo dataset. For a live source, tighten to e.g. 1 / 2.
SOURCE_FRESHNESS_WARN_DAYS=7
SOURCE_FRESHNESS_ERROR_DAYS=365
